# Signs login tokens. Use any long random string. Without it, everyone is signed out on each restart.
SECRET_KEY=change-me

# Read-only GitHub token (no scopes needed for public repositories). Raises the API limit from 60 to 5000 requests an hour.
GITHUB_TOKEN=

# owner/name of your public copy of the sample repository, so demo evidence links open on GitHub.
DEMO_REPO=

# Optional. PostgreSQL connection string (for example from Neon). Default is a local SQLite file.
DATABASE_URL=

# Optional. Any OpenAI-compatible chat endpoint. When set, an LLM proposes extra claims from uploaded documents.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=
